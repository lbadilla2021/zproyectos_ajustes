<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_form_personas_asignadas" model="ir.ui.view">
        <field name="name">project.task.form.personas.asignadas</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='extra_info']" position="after">
                <page string="Personas Asignadas" name="barca_personas_asignadas">
                    <field name="persona_asignada_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="funcion_id"
                                   domain="[('active', '=', True)]"
                                   options="{'no_create_edit': True}"/>
                            <field name="allowed_employee_ids" column_invisible="True"/>
                            <field name="employee_id"
                                   domain="[('id', 'in', allowed_employee_ids)]"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="tipo_jornada_id" readonly="1" options="{'no_open': True}"/>
                            <field name="ciudad_id" readonly="1" options="{'no_open': True}"/>
                            <field name="licencia"/>
                            <field name="equipo_id" options="{'no_create_edit': True}"/>
                            <field name="equipment_category_id"
                                   string="Categoría"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="vehicle_equipment_id"
                                   string="Vehículo"
                                   domain="[('category_id', '=', equipment_category_id), ('category_id', '!=', False)]"
                                   readonly="not equipment_category_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
