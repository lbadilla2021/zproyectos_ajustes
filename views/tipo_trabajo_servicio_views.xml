<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_tipo_trabajo_list" model="ir.ui.view">
        <field name="name">it.tipo.trabajo.list</field>
        <field name="model">it.tipo.trabajo</field>
        <field name="arch" type="xml">
            <list string="Tipos de trabajo">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_it_tipo_trabajo_form" model="ir.ui.view">
        <field name="name">it.tipo.trabajo.form</field>
        <field name="model">it.tipo.trabajo</field>
        <field name="arch" type="xml">
            <form string="Tipo de trabajo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_tipo_trabajo" model="ir.actions.act_window">
        <field name="name">Tipos de trabajo</field>
        <field name="res_model">it.tipo.trabajo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_it_tipo_servicio_list" model="ir.ui.view">
        <field name="name">it.tipo.servicio.list</field>
        <field name="model">it.tipo.servicio</field>
        <field name="arch" type="xml">
            <list string="Tipos de servicio">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_it_tipo_servicio_form" model="ir.ui.view">
        <field name="name">it.tipo.servicio.form</field>
        <field name="model">it.tipo.servicio</field>
        <field name="arch" type="xml">
            <form string="Tipo de servicio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_tipo_servicio" model="ir.actions.act_window">
        <field name="name">Tipos de servicio</field>
        <field name="res_model">it.tipo.servicio</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_it_equipo_list" model="ir.ui.view">
        <field name="name">it.equipo.list</field>
        <field name="model">it.equipo</field>
        <field name="arch" type="xml">
            <list string="Equipos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_it_equipo_form" model="ir.ui.view">
        <field name="name">it.equipo.form</field>
        <field name="model">it.equipo</field>
        <field name="arch" type="xml">
            <form string="Equipo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_equipo" model="ir.actions.act_window">
        <field name="name">Equipo</field>
        <field name="res_model">it.equipo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_it_tipo_trabajo"
              name="Tipos de trabajo"
              parent="project.menu_project_config"
              action="action_it_tipo_trabajo"
              groups="project.group_project_manager"
              sequence="95"/>

    <menuitem id="menu_it_tipo_servicio"
              name="Tipos de servicio"
              parent="project.menu_project_config"
              action="action_it_tipo_servicio"
              groups="project.group_project_manager"
              sequence="96"/>

    <!-- La configuracion debe estar disponible para usuarios de Proyectos, pero
         sus mantenedores estandar permanecen restringidos a administradores. -->
    <record id="project.menu_project_config" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="project.menu_projects_config" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="project.menu_project_tags_act" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="project.project_menu_config_activity_type" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="project.mail_activity_plan_menu_config_project" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

    <menuitem id="menu_project_barca_tablas"
              name="Tablas"
              parent="project.menu_project_config"
              groups="project.group_project_user"
              sequence="97"/>

    <menuitem id="menu_it_equipo"
              name="Equipo"
              parent="menu_project_barca_tablas"
              action="action_it_equipo"
              groups="project.group_project_manager"
              sequence="20"/>
</odoo>
